# ==========================================
# AI HELP DESK - CONFIGURAÇÕES DE AMBIENTE
# ==========================================
# Copie este arquivo para .env e preencha com seus valores locais.
# NUNCA envie o arquivo .env real para o Git/GitHub.

# Ambiente da aplicação (development | test | production)
APP_ENV=development

# Provedor de IA (gemini | openai | rules_fallback)
# Quando nenhuma chave de API é configurada, o sistema utiliza o classificador
# baseado em regras (identificado explicitamente como origem: REGRAS / fallback).
AI_PROVIDER=gemini
GEMINI_API_KEY=sua_chave_api_aqui
AI_MODEL=gemini-2.5-flash

# Banco de Dados (será utilizado na Etapa 3)
DATABASE_URL=sqlite:///./helpdesk.db

# Integração de Automação com n8n (será utilizada na Etapa 6)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/helpdesk-chamados
N8N_WEBHOOK_ENABLED=false

